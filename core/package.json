{
  "name": "@tabler/core",
  "version": "1.4.0",
  "description": "Premium and Open Source dashboard template with responsive and high quality UI.",
  "homepage": "https://tabler.io",
  "scripts": {
    "dev": "pnpm run watch",
    "dev-prepare": "pnpm run clean && pnpm run copy && concurrently \"pnpm run css-build\" \"pnpm run js-build\"",
    "build": "pnpm run clean && pnpm run build-assets && pnpm run copy",
    "build-assets": "concurrently \"pnpm run css\" \"pnpm run js\"",
    "clean": "shx rm -rf dist demo",
    "css": "tsx ../.build/build-css.ts scss dist/css --minify --banner --no-maps --min-only",
    "css-build": "tsx ../.build/build-css.ts scss dist/css --minify",
    "css-lint": "pnpm run lint:scss && pnpm run css-lint-variables",
    "lint:scss": "stylelint \"scss/**/*.scss\" --config ../stylelint.config.mjs",
    "lint:scss:fix": "pnpm run lint:scss --fix",
    "css-lint-variables": "find-unused-sass-variables scss/",
    "js": "cross-env TABLER_SOURCEMAP=false pnpm run js-build && pnpm run js-build-min",
    "js-build": "concurrently \"pnpm run js-build-standalone\" \"pnpm run js-build-theme\"",
    "js-build-theme": "cross-env BASE_NAME=tabler-theme vite build --config .build/vite.config.mts",
    "js-build-standalone": "cross-env BASE_NAME=tabler vite build --config .build/vite.config.mts",
    "js-build-min": "concurrently \"pnpm run js-build-min-standalone\" \"pnpm run js-build-min-theme\"",
    "js-build-min-standalone": "concurrently \"terser dist/js/tabler.js --compress --mangle --comments '/@license|@preserve|^!/' -o dist/js/tabler.min.js\" \"terser dist/js/tabler.esm.js --module --compress --mangle --comments '/@license|@preserve|^!/' -o dist/js/tabler.esm.min.js\"",
    "js-build-min-theme": "concurrently \"terser dist/js/tabler-theme.js --compress --mangle --comments '/@license|@preserve|^!/' -o dist/js/tabler-theme.min.js\" \"terser dist/js/tabler-theme.esm.js --module --compress --mangle --comments '/@license|@preserve|^!/' -o dist/js/tabler-theme.esm.min.js\"",
    "copy": "concurrently \"pnpm run copy-img\" \"pnpm run copy-libs\" \"pnpm run copy-fonts\"",
    "copy-img": "shx mkdir -p dist/img && shx cp -rf img/* dist/img",
    "copy-libs": "tsx .build/copy-libs.ts",
    "copy-fonts": "shx mkdir -p dist/fonts/geist-sans dist/fonts/geist-mono && shx cp -f fonts/geist-sans/*.woff2 dist/fonts/geist-sans/ && shx cp -f fonts/geist-mono/*.woff2 dist/fonts/geist-mono/",
    "import-fonts": "tsx .build/import-fonts.ts",
    "watch": "concurrently \"pnpm run watch-css\" \"pnpm run watch-js\"",
    "watch-css": "nodemon --watch scss/ --ext scss --exec \"pnpm run css-build\"",
    "watch-js": "nodemon --watch js/ --ext ts,js --exec \"pnpm run js-build\"",
    "bundlewatch": "bundlewatch",
    "type-check": "tsc --noEmit",
    "test": "concurrently \"pnpm run test:js\" \"pnpm run test:scss\"",
    "test:js": "vitest run",
    "test:scss": "vitest run --config vitest.scss.config.mjs",
    "test:js:watch": "vitest",
    "test:js:coverage": "vitest run --coverage",
    "test:scss:watch": "vitest --config vitest.scss.config.mjs",
    "test:watch": "pnpm run test:js:watch",
    "test:coverage": "pnpm run test:js:coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabler/tabler.git"
  },
  "keywords": [
    "css",
    "sass",
    "mobile-first",
    "responsive",
    "front-end",
    "framework",
    "web"
  ],
  "author": "codecalm",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tabler/tabler/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/codecalm"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "docs/**/*",
    "dist/**/*",
    "js/**/*.{ts,js,map}",
    "img/**/*.{svg}",
    "scss/**/*.scss",
    "libs.json"
  ],
  "style": "dist/css/tabler.min.css",
  "sass": "scss/tabler.scss",
  "unpkg": "dist/js/tabler.min.js",
  "umd:main": "dist/js/tabler.min.js",
  "module": "dist/js/tabler.esm.js",
  "main": "dist/js/tabler.js",
  "bundlewatch": {
    "files": [
      {
        "path": "./dist/css/tabler.min.css",
        "maxSize": "78 kB"
      },
      {
        "path": "./dist/css/tabler-marketing.min.css",
        "maxSize": "8.5 kB"
      },
      {
        "path": "./dist/css/tabler-props.min.css",
        "maxSize": "4.6 kB"
      },
      {
        "path": "./dist/css/tabler-socials.min.css",
        "maxSize": "2.1 kB"
      },
      {
        "path": "./dist/css/tabler-themes.min.css",
        "maxSize": "1.4 kB"
      },
      {
        "path": "./dist/css/tabler-vendors.min.css",
        "maxSize": "6.7 kB"
      },
      {
        "path": "./dist/js/tabler.js",
        "maxSize": "64 kB"
      },
      {
        "path": "./dist/js/tabler.min.js",
        "maxSize": "48 kB"
      },
      {
        "path": "./dist/js/tabler.esm.js",
        "maxSize": "64 kB"
      },
      {
        "path": "./dist/js/tabler.esm.min.js",
        "maxSize": "48 kB"
      },
      {
        "path": "./dist/js/tabler-theme.js",
        "maxSize": "1 kB"
      },
      {
        "path": "./dist/js/tabler-theme.esm.js",
        "maxSize": "1 kB"
      },
      {
        "path": "./dist/js/tabler-theme.min.js",
        "maxSize": "800 B"
      },
      {
        "path": "./dist/js/tabler-theme.esm.min.js",
        "maxSize": "800 B"
      }
    ]
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.62.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "apexcharts": "7.0.0",
    "autosize": "^6.0.1",
    "choices.js": "^11.2.4",
    "clipboard": "^2.0.11",
    "countup.js": "^2.10.1",
    "dropzone": "^6.0.0-beta.2",
    "find-unused-sass-variables": "^6.2.1",
    "flatpickr": "^4.6.13",
    "geist": "1.7.2",
    "hugerte": "^1.0.12",
    "imask": "^7.6.1",
    "datatables.net": "^3.0.3",
    "datatables.net-bs5": "^3.0.3",
    "datatables.net-responsive": "^4.0.2",
    "datatables.net-responsive-bs5": "^4.0.2",
    "datatables.net-buttons": "^4.0.2",
    "datatables.net-buttons-bs5": "^4.0.2",
    "datatables.net-select": "^4.0.1",
    "datatables.net-select-bs5": "^4.0.1",
    "litepicker": "^2.0.12",
    "nouislider": "^15.8.1",
    "signature_pad": "^5.1.4",
    "sass": "1.103.1",
    "sass-true": "^10.1.0",
    "sortablejs": "^1.15.7",
    "star-rating.js": "^4.3.1",
    "tom-select": "^2.6.2",
    "typed.js": "^3.0.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "directories": {
    "doc": "docs"
  }
}
