---
import NavbarToggler from './NavbarToggler.astro'
import Logo from './Logo.astro'
import NavbarMenu from './NavbarMenu.astro'
import SidebarUser from './SidebarUser.astro'
import Icon from '@ui/Icon.astro'
import type { Breakpoint } from './NavbarSide.astro'

interface Props {
  dark?: boolean | undefined
  breakpoint?: Breakpoint | undefined
  /** renders a user block in the sidebar footer */
  user?: boolean | undefined
  /** active menu entry, e.g. "layout.vertical" */
  pageMenu?: string | undefined
}

const { dark = false, breakpoint = 'lg', user = false, pageMenu } = Astro.props

const asideClass = ['navbar navbar-vertical', `navbar-expand-${breakpoint}`].filter(Boolean).join(' ')
---

<!-- BEGIN SIDEBAR -->
<aside class={asideClass} data-bs-theme={dark ? 'dark' : undefined}>
  <div class="container-fluid">
    <NavbarToggler target="sidebar-menu" />

    <Logo header smallLogo />

    {
      /* Before the collapse, like the regular navbar's side items — on mobile it
        stays in the top bar row; on desktop CSS order moves it to the bottom. */
    }
    {user && <SidebarUser />}

    <nav class="collapse navbar-collapse" id="sidebar-menu" aria-label="Sidebar">
      <NavbarMenu autoOpen class="pt-lg-3" keepOpen sections pageMenu={pageMenu} />
    </nav>
  </div>
</aside>
<!-- END SIDEBAR -->
