---
import Button from '@ui/Button.astro'
import ButtonList from '@ui/ButtonList.astro'
import NavbarSideTheme from './NavbarSideTheme.astro'
import NavbarSideNotifications from './NavbarSideNotifications.astro'
import NavbarSideApps from './NavbarSideApps.astro'
import NavbarSideLanguage from './NavbarSideLanguage.astro'
import NavbarSideUser from './NavbarSideUser.astro'
import { site } from '@shared/lib/site'

/** Bootstrap responsive breakpoint used for `d-{breakpoint}-flex` — $grid-breakpoints minus xs */
export type Breakpoint = 'sm' | 'md' | 'lg' | 'xl' | 'xxl'

interface Props {
  class?: string
  breakpoint?: Breakpoint | undefined
  personId?: number | undefined
  hideUsername?: boolean
  showThemeToggle?: boolean
  showNotifications?: boolean
  showApps?: boolean
  showLanguageSelector?: boolean
  showUser?: boolean
}

const {
  class: className,
  breakpoint = 'md',
  personId = 1,
  hideUsername = false,
  // show-* flags default false — sidebar only shows the Sponsor button unless set.
  showThemeToggle = false,
  showNotifications = false,
  showApps = false,
  showLanguageSelector = false,
  showUser = false,
} = Astro.props
---

<!-- BEGIN NAVBAR ACTIONS -->
<div class:list={['navbar-nav flex-row', className]}>
  <div class={`nav-item d-none d-${breakpoint}-flex me-3`}>
    <ButtonList>
      <Button icon="heart" iconColor="pink" text="Sponsor" href={site.githubSponsorsUrl} external />
    </ButtonList>
  </div>

  {
    (showThemeToggle || showNotifications || showApps || showLanguageSelector) && (
      <div class={`d-none d-${breakpoint}-flex me-3`}>
        {showThemeToggle && <NavbarSideTheme />}
        {showNotifications && <NavbarSideNotifications />}
        {showApps && <NavbarSideApps />}
        {showLanguageSelector && <NavbarSideLanguage />}
      </div>
    )
  }

  {showUser && <NavbarSideUser personId={personId} hideUsername={hideUsername} />}
</div>
<!-- END NAVBAR ACTIONS -->
