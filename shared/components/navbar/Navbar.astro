---
import Icon from '@ui/Icon.astro';
import Logo from './Logo.astro';
import NavbarToggler from './NavbarToggler.astro';
import NavbarSide from './NavbarSide.astro';
import NavbarMenu from './NavbarMenu.astro';
import NavbarSearch from './NavbarSearch.astro';

interface Props {
	hideSearch?: boolean;
	/** active menu entry, e.g. "dashboards.default" */
	pageMenu?: string | undefined;
	/** use the sample menu (menu-sample.json) instead of the real one */
	sample?: boolean;
	/** 1-based index into people.json for the user menu avatar */
	personId?: number;
	hideLogo?: boolean;
	smallLogo?: boolean;
	showTitle?: boolean;
	hideIcons?: boolean;
	hideUsername?: boolean;
}

// When a page passes no pageMenu, nothing in the menu is active.
const {
	hideSearch = false,
	pageMenu,
	sample = false,
	personId,
	hideLogo = false,
	smallLogo = false,
	showTitle = false,
	hideIcons = false,
	hideUsername = false,
} = Astro.props;

const breakpoint = 'md';

const headerClass = [`navbar navbar-expand-${breakpoint}`, 'd-print-none']
---

<!-- BEGIN NAVBAR -->
<header class:list={headerClass}>
	<div class="container-xl">
		<NavbarToggler target="navbar-menu" />

		<Logo header class="d-none-navbar-horizontal pe-0 pe-md-3" smallLogo={smallLogo} hideLogo={hideLogo} showTitle={showTitle} />

		<NavbarSide
			class="order-md-last"
			breakpoint={breakpoint}
			personId={personId}
			hideUsername={hideUsername}
			showThemeToggle
			showNotifications
			showApps
			showLanguageSelector
			showUser
		/>
	</div>
</header>

<div class={`navbar-expand-${breakpoint}`}>
	<div class="collapse navbar-collapse" id="navbar-menu">
		<div class="navbar">
			<div class="container-xl">
				<div class="row flex-column flex-md-row flex-fill align-items-center">
					<div class="col">
						<!-- BEGIN NAVBAR MENU -->
						<nav aria-label="Primary">
							<NavbarMenu longTitles sample={sample} hideIcons={hideIcons} pageMenu={pageMenu} />
						</nav>
						<!-- END NAVBAR MENU -->
					</div>

					{!hideSearch && (
						<div class="col-2 d-none d-xxl-block">
							<NavbarSearch class="my-2 my-md-0 flex-grow-1 flex-md-grow-0 order-first order-md-last" />
						</div>
					)}

					<div class="col col-md-auto">
						<!-- BEGIN NAVBAR NAV -->
						<ul class="navbar-nav">
							<li class="nav-item">
								<a class="nav-link" href="#" data-bs-toggle="offcanvas" data-bs-target="#offcanvas-settings">
									<span class="badge badge-sm bg-danger text-danger-fg"> New </span>
									<span class="nav-link-icon">
										<Icon name="settings" />
									</span>
									<span class="nav-link-title"> Theme Settings </span>
								</a>
							</li>
						</ul>
						<!-- END NAVBAR NAV -->
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- END NAVBAR -->
