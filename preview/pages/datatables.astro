---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
import { toUnixSeconds, formatLongDate } from '@shared/lib/date-format'
import { randomNumber, randomDate } from '@shared/lib/pseudo-random'
import Card from '@ui/Card.astro'
import CardHeader from '@ui/CardHeader.astro'
import CardBody from '@ui/CardBody.astro'
import CardTitle from '@ui/CardTitle.astro'
import CardSubtitle from '@ui/CardSubtitle.astro'
import Progress from '@ui/Progress.astro'
import DataTable from '@shared/components/js/DataTable.astro'
import rollercoasters from '@data/rollercoasters.json'

interface Rollercoaster {
  name: string
  city: string
  type: string
  score: string
}

const rows = (rollercoasters as Rollercoaster[]).map((rc, i) => {
  const index = i + 1
  const progress = randomNumber(index, 0, 100)
  const date = randomDate(index)
  return {
    rc,
    progress,
    quantity: randomNumber(index, 1, 200),
    dateSeconds: toUnixSeconds(date),
    dateLabel: formatLongDate(date),
  }
})
---

<DefaultLayout title="Datatables" pageMenu="plugins.datatables" pageLibs={['datatables', 'datatables-bs5', 'datatables-responsive', 'datatables-responsive-bs5', 'datatables-buttons', 'datatables-buttons-bs5', 'datatables-select', 'datatables-select-bs5']}>
  <Card>
    <CardHeader>
      <div>
        <CardTitle>Sortable table</CardTitle>
        <CardSubtitle>Search, sort and paginate with DataTables.net — click a column header to sort.</CardSubtitle>
      </div>
    </CardHeader>
    <CardBody class="p-0">
      <div class="table-responsive">
        <table id="datatable" class="table">
          <thead>
            <tr>
              <th>Name</th>
              <th>City</th>
              <th>Type</th>
              <th>Score</th>
              <th>Date</th>
              <th>Quantity</th>
              <th>Progress</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map(({ rc, progress, quantity, dateSeconds, dateLabel }) => (
                <tr>
                  <td>{rc.name}</td>
                  <td>{rc.city}</td>
                  <td>{rc.type}</td>
                  <td>{rc.score}</td>
                  <td data-order={dateSeconds}>{dateLabel}</td>
                  <td>{quantity}</td>
                  <td data-order={progress}>
                    <div class="row align-items-center">
                      <div class="col-12 col-lg-auto">{progress}%</div>
                      <div class="col">
                        <Progress value={progress} width="5rem" />
                      </div>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </CardBody>
  </Card>

  <Card>
    <CardHeader>
      <div>
        <CardTitle>Selection, export and responsive</CardTitle>
        <CardSubtitle>
          <span data-dt-selected-count="datatable-advanced">0</span> selected — click a row or use the header checkbox. Columns collapse on small screens.
        </CardSubtitle>
      </div>
    </CardHeader>
    <CardBody class="p-0">
      <div class="table-responsive">
        <table id="datatable-advanced" class="table table-vcenter">
          <thead>
            <tr>
              <th class="w-1">
                <input type="checkbox" class="form-check-input m-0 align-middle" aria-label="Select all rows" />
              </th>
              <th>Name</th>
              <th>City</th>
              <th>Type</th>
              <th>Score</th>
              <th>Date</th>
              <th>Quantity</th>
              <th>Progress</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map(({ rc, progress, quantity, dateSeconds, dateLabel }, rowIndex) => (
                <tr>
                  <td>
                    <input type="checkbox" class="form-check-input m-0 align-middle" aria-label={`Select row ${rowIndex + 1}`} />
                  </td>
                  <td>{rc.name}</td>
                  <td>{rc.city}</td>
                  <td>{rc.type}</td>
                  <td>{rc.score}</td>
                  <td data-order={dateSeconds}>{dateLabel}</td>
                  <td>{quantity}</td>
                  <td data-order={progress}>{progress}%</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </CardBody>
  </Card>

  <DataTable id="datatable" />
  <DataTable id="datatable-advanced" select="multi" responsive buttons={['copy', 'csv', 'print', 'colvis']} />
</DefaultLayout>
